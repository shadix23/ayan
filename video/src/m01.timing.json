 "durationInFrames": 1622,
 "lines": [
  {
   "id": 1,
   "srcStart": 0,
   "srcEnd": 5.651,
   "start": 0.9,
   "end": 6.551,
   "sentences": [
    {
     "ru": "Привет!",
     "kk": "Сәлем!",
     "start": 0.9,
     "end": 1.472
    },
    {
     "ru": "Давай узнаем, что такое четверть.",
     "kk": "Ширек деген не екенін білейік.",
     "start": 1.733,
     "end": 4.08
    },
    {
     "ru": "Перед нами один целый круг.",
     "kk": "Алдымызда бір бүтін дөңгелек тұр.",
     "start": 4.524,
     "end": 6.411
    }
   ]
  },
  {
   "id": 2,
   "srcStart": 5.871,
   "srcEnd": 11.96,
   "start": 7.451,
   "end": 13.54,
   "sentences": [
    {
     "ru": "Разделим его на четыре равные части.",
     "kk": "Оны тең төрт бөлікке бөлейік.",
     "start": 7.531,
     "end": 10.044
    },
    {
     "ru": "Посмотри: все части одинакового размера.",
     "kk": "Қарашы: барлық бөліктің өлшемі бірдей.",
     "start": 10.48,
     "end": 13.4
    }
   ]
  },
  {
   "id": 3,
   "srcStart": 12.163,
   "srcEnd": 22.107,
   "start": 14.44,
   "end": 24.384,
   "sentences": [
    {
     "ru": "Одна из этих частей - одна четверть.",
     "kk": "Осы бөліктердің біреуі - бір ширек.",
     "start": 14.52,
     "end": 17.019
    },
    {
     "ru": "В записи дроби число внизу показывает, на сколько равных частей разделили целое.",
     "kk": "Бөлшектің жазылуында астыңғы сан бүтіннің неше тең бөлікке бөлінгенін көрсетеді.",
     "start": 17.445,
     "end": 22.664
    },
    {
     "ru": "Здесь их четыре.",
     "kk": "Мұнда олар төртеу.",
     "start": 23.094,
     "end": 24.244
    }
   ]
  },
  {
   "id": 4,
   "srcStart": 22.284,
   "srcEnd": 29.405,
   "start": 25.284,
   "end": 32.405,
   "sentences": [
    {
     "ru": "Число сверху показывает, сколько частей мы взяли.",
     "kk": "Үстіңгі сан неше бөлік алғанымызды көрсетеді.",
     "start": 25.364,
     "end": 28.37
    },
    {
     "ru": "Сейчас взяли одну.",
     "kk": "Қазір біреуін алдық.",
     "start": 28.772,
     "end": 30.114
    },
    {
     "ru": "Получилась одна четвёртая.",
     "kk": "Төрттен бір шықты.",
     "start": 30.529,
     "end": 32.265
    }
   ]
  },
  {
   "id": 5,
   "srcStart": 29.552,
   "srcEnd": 35.286,
   "start": 33.305,
   "end": 39.039,
   "sentences": [
    {
     "ru": "А если выделить две такие части?",
     "kk": "Ал осындай екі бөлікті белгілесек ше?",
     "start": 33.385,
     "end": 35.493
    },
    {
     "ru": "Получатся две четверти - половина этого круга.",
     "kk": "Төрттен екі шығады - бұл осы дөңгелектің жартысы.",
     "start": 35.93,
     "end": 38.899
    }
   ]
  },
  {
   "id": 6,
   "srcStart": 35.407,
   "srcEnd": 41.561,
   "start": 39.939,
   "end": 46.094,
   "sentences": [
    {
     "ru": "Важно делить на равные части.",
     "kk": "Тең бөліктерге бөлу маңызды.",
     "start": 40.019,
     "end": 41.949
    },
    {
     "ru": "Одна из четырёх неравных частей не обязательно будет четвертью.",
     "kk": "Тең емес төрт бөліктің біреуі міндетті түрде ширек бола бермейді.",
     "start": 42.397,
     "end": 45.954
    }
   ]
  },
  {
   "id": 7,
   "srcStart": 41.746,
   "srcEnd": 46.6,
   "start": 46.994,
   "end": 51.847,
   "sentences": [
    {
     "ru": "Теперь твоя очередь.",
     "kk": "Енді сенің кезегің.",
     "start": 47.074,
     "end": 48.316
    },
    {
     "ru": "Выбери одну четверть в игре.",
     "kk": "Ойында бір ширекті таңда.",
     "start": 48.604,
     "end": 50.351
    },
    {
     "ru": "Можно не спешить.",
     "kk": "Асықпауға болады.",
     "start": 50.728,
     "end": 51.847
    }
   ]
  }
 ]
}
